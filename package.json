{
  "name": "monkey-monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "prettier --cache --write --ignore-unknown .",
    "lint": "eslint --cache --fix .",
    "build": "pnpm -r --filter=./create-monkey --filter=./vite-plugin-monkey build",
    "build:playground": "pnpm -r --filter=./playground/* build"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/minimist": "catalog:",
    "@types/node": "catalog:",
    "@types/postcss-url": "catalog:",
    "@types/prompts": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "acorn": "catalog:",
    "acorn-walk": "catalog:",
    "element-plus": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "execa": "catalog:",
    "fs-extra": "catalog:",
    "lint-staged": "catalog:",
    "magic-string": "catalog:",
    "minimist": "catalog:",
    "normalize.css": "catalog:",
    "picocolors": "catalog:",
    "pinia": "catalog:",
    "postcss-url": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass-embedded": "catalog:",
    "semver": "catalog:",
    "simple-git-hooks": "catalog:",
    "solid-js": "catalog:",
    "terser": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unimport": "catalog:",
    "unocss": "catalog:",
    "unplugin-auto-import": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vue": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ],
    "*.{json,jsx,tsx,vue}": [
      "prettier --cache --write"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "error"
    }
  }
}
